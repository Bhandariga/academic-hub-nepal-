# ==============================================================================
# AcademicHub Nepal - Environment Configuration Template
# Duplicate this file as '.env' on your production server
# ==============================================================================

# Application Environment: 'production' or 'development'
APP_ENV=production

# Database Credentials
DB_HOST=localhost
DB_PORT=3306
DB_NAME=academic_hub
DB_USER=academic_user
DB_PASS=YourStrongDatabasePassword123!

# Official eSewa ePay V2 Configuration
# For live production, obtain your Merchant Code and Secret Key from eSewa Nepal
ESEWA_URL=https://epay.esewa.com.np/api/epay/main/v2/form
ESEWA_STATUS_URL=https://epay.esewa.com.np/api/epay/transaction/status/
ESEWA_PRODUCT_CODE=YOUR_MERCHANT_CODE
ESEWA_SECRET_KEY=YOUR_PRODUCTION_SECRET_KEY

# Canonical production origin and installation path
APP_URL=https://your-domain.example
# Explicit CLI-only legacy initialization; leave disabled for normal operation
ALLOW_DB_SETUP=0

# Trust forwarded TLS headers only behind a proxy that strips incoming spoofed headers.
TRUST_PROXY=0
# Configure PHP mail() transport / local MTA first; no email is sent until enabled.
AUTH_MAIL_ENABLED=0
MAIL_FROM=accounts@your-domain.example
# ClamAV must be private to this host/network; INSTREAM limit must exceed 50 MB.
CLAMAV_ADDRESS=tcp://127.0.0.1:3310
UPLOAD_SCAN_REQUIRED=1
